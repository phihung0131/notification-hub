{
 "uid": "nh-overview",
 "title": "Notification Hub - Services",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "5s",
 "editable": true,
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "tags": [
  "notification-hub"
 ],
 "templating": {
  "list": [
   {
    "name": "service",
    "label": "Service",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "multi": true,
    "includeAll": true,
    "allValue": "gateway|tenant|notification|delivery|analytics",
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "query": {
     "query": "label_values(jvm_memory_used_bytes, job)",
     "refId": "q"
    },
    "refresh": 2
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Requests per second",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "fillOpacity": 8,
      "lineWidth": 1
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (job) (rate(http_server_requests_seconds_count{job=~\"$service\",uri!~\".*actuator.*\"}[30s]))",
     "legendFormat": "{{job}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
