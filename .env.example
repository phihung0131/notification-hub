# Copy to .env (optional: every value has a default in compose.yaml)
POSTGRES_PASSWORD=postgres
TENANT_DB_PASSWORD=tenant
NOTIFICATION_DB_PASSWORD=notification
ANALYTICS_DB_PASSWORD=analytics
DELIVERY_DB_PASSWORD=delivery
# Partitions for notification.requested / notification.result (max consumer parallelism)
TOPIC_PARTITIONS=12
# Set by `make obs` to enable the OpenTelemetry java agent
# OTEL_AGENT_OPTS=-javaagent:/opt/otel-agent.jar
