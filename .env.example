# ================================================
# NOTIFICATION HUB - Environment Variables Template
# ================================================
# Copy this file to .env and update values for your environment
# DO NOT commit .env file (contains secrets)

# ================================================
# GATEWAY SERVICE (Port 9000)
# ================================================

# Spring Application
GATEWAY_SPRING_APPLICATION_NAME=gateway-service

# Redis Configuration (for rate limiting)
GATEWAY_REDIS_HOST=localhost
GATEWAY_REDIS_PORT=6379

# Tenant Service Connection
GATEWAY_TENANT_SERVICE_URL=http://localhost:9001

# Logging
GATEWAY_LOG_LEVEL=INFO

# ================================================
# TENANT SERVICE (HTTP: 9001, gRPC: 50001)
# ================================================

# Spring Application
TENANT_SPRING_APPLICATION_NAME=tenant-service

# Database Configuration
TENANT_DB_URL=jdbc:postgresql://localhost:5432/tenant_db
TENANT_DB_USERNAME=postgres
TENANT_DB_PASSWORD=postgres

# Redis Configuration (for caching)
TENANT_REDIS_HOST=localhost
TENANT_REDIS_PORT=6379

# Kafka Configuration
TENANT_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
TENANT_KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8081
TENANT_KAFKA_CONSUMER_GROUP=tenant-consumer-group

# Kafka Topics
TENANT_KAFKA_TOPIC_RESULT=notification.result

# gRPC Server
TENANT_GRPC_SERVER_PORT=50001

# JWT Configuration
TENANT_JWT_SECRET=your-secret-key-must-be-at-least-256-bits-long-change-this-in-production
TENANT_JWT_EXPIRATION=86400000

# Quota Batch Processing
TENANT_BATCH_SIZE=50
TENANT_BATCH_FLUSH_INTERVAL=5000

# Logging
TENANT_LOG_LEVEL=INFO

# ================================================
# NOTIFICATION SERVICE (HTTP: 9002, gRPC: 50002)
# ================================================

# Spring Application
NOTIFICATION_SPRING_APPLICATION_NAME=notification-service

# Database Configuration
NOTIFICATION_DB_URL=jdbc:postgresql://localhost:5433/notification_db
NOTIFICATION_DB_USERNAME=postgres
NOTIFICATION_DB_PASSWORD=postgres

# Redis Configuration (for quota cache)
NOTIFICATION_REDIS_HOST=localhost
NOTIFICATION_REDIS_PORT=6379

# Kafka Configuration
NOTIFICATION_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
NOTIFICATION_KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8081

# Kafka Topics
NOTIFICATION_KAFKA_TOPIC_REQUESTED=notification.requested

# gRPC Client (Tenant Service)
NOTIFICATION_GRPC_TENANT_ADDRESS=static://localhost:50001

# Logging
NOTIFICATION_LOG_LEVEL=INFO

# ================================================
# DELIVERY SERVICE (HTTP: 9003)
# ================================================

# Spring Application
DELIVERY_SPRING_APPLICATION_NAME=delivery-service

# Kafka Configuration
DELIVERY_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
DELIVERY_KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8081
DELIVERY_KAFKA_CONSUMER_GROUP=delivery-consumer-group

# Kafka Topics
DELIVERY_KAFKA_TOPIC_REQUESTED=notification.requested
DELIVERY_KAFKA_TOPIC_RESULT=notification.result
DELIVERY_KAFKA_TOPIC_DLQ=notification.dlq

# Delivery Configuration
DELIVERY_MAX_RETRIES=3
DELIVERY_INITIAL_BACKOFF_MS=500
DELIVERY_MAX_BACKOFF_MS=5000

# Logging
DELIVERY_LOG_LEVEL=INFO

# ================================================
# ANALYTICS SERVICE (HTTP: 9004)
# ================================================

# Spring Application
ANALYTICS_SPRING_APPLICATION_NAME=analytics-service

# Database Configuration
ANALYTICS_DB_URL=jdbc:postgresql://localhost:5435/analytics_db
ANALYTICS_DB_USERNAME=postgres
ANALYTICS_DB_PASSWORD=postgres

# Kafka Configuration
ANALYTICS_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
ANALYTICS_KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8081
ANALYTICS_KAFKA_CONSUMER_GROUP=analytics-consumer-group

# Kafka Topics
ANALYTICS_KAFKA_TOPIC_REQUESTED=notification.requested
ANALYTICS_KAFKA_TOPIC_RESULT=notification.result

# Batch Processing
ANALYTICS_BATCH_SIZE=50
ANALYTICS_BATCH_FLUSH_INTERVAL=5000

# Logging
ANALYTICS_LOG_LEVEL=INFO

# ================================================
# SHARED INFRASTRUCTURE
# ================================================

# Kafka Cluster
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8081

# PostgreSQL Databases
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# ================================================
# OBSERVABILITY (Optional)
# ================================================

# OpenTelemetry
OTEL_SERVICE_NAME=notification-hub
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp

# Jaeger (Tracing UI)
JAEGER_UI_PORT=16686
JAEGER_COLLECTOR_PORT=14250

# ================================================
# DEVELOPMENT vs PRODUCTION
# ================================================

# Environment
ENVIRONMENT=development
# Options: development, staging, production

# Debug Mode
SPRING_PROFILES_ACTIVE=dev
# Options: dev, test, prod

# Debug Ports (for remote debugging)
TENANT_DEBUG_PORT=5001
NOTIFICATION_DEBUG_PORT=5002
DELIVERY_DEBUG_PORT=5003
ANALYTICS_DEBUG_PORT=5004

# ================================================
# SECURITY NOTES
# ================================================
# 1. Change JWT_SECRET in production (min 256 bits)
# 2. Use strong database passwords
# 3. Enable SSL/TLS for Kafka in production
# 4. Use HashiCorp Vault or AWS Secrets Manager for secrets
# 5. Rotate API keys regularly
