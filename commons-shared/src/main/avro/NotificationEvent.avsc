{
  "type": "record",
  "namespace": "org.example.events",
  "name": "NotificationEvent",
  "doc": "Schema cho sự kiện thông báo (NotificationEventDto)",
  "fields": [
    {
      "name": "id",
      "type": ["null", { "type": "string", "logicalType": "uuid" }],
      "default": null
    },
    {
      "name": "tenantId",
      "type": ["null", "string"],
      "default": null
    },
    {
      "name": "channel",
      "type": ["null", "string"],
      "default": null
    },
    {
      "name": "recipient",
      "type": ["null", "string"],
      "default": null
    },
    {
      "name": "subject",
      "type": ["null", "string"],
      "default": null
    },
    {
      "name": "content",
      "type": ["null", "string"],
      "default": null
    },
    {
      "name": "status",
      "default": null,
      "type": ["null", {
        "type": "enum",
        "name": "NotificationStatus",
        "namespace": "org.example.events.enums",
        "doc": "Các trạng thái của một thông báo",
        "symbols": [
          "PENDING",
          "SENT",
          "FAILED",
          "READ",
          "ACKNOWLEDGED"
        ]
      }]
    },
    {
      "name": "createdAt",
      "type": ["null", { "type": "long", "logicalType": "timestamp-millis" }],
      "default": null
    },
    {
      "name": "priority",
      "doc": "Priority lane: HIGH | NORMAL | LOW. Null means NORMAL. Added in v2 (optional).",
      "type": ["null", "string"],
      "default": null
    },
    {
      "name": "idempotencyKey",
      "doc": "Client Idempotency-Key (per tenant). Added in v2 (optional).",
      "type": ["null", "string"],
      "default": null
    },
    {
      "name": "requestFingerprint",
      "doc": "SHA-256 of the canonical request payload; used to detect key reuse with a different payload. Added in v2 (optional).",
      "type": ["null", "string"],
      "default": null
    },
    {
      "name": "version",
      "doc": "Monotonic event version of the notification state (guards against out-of-order events). Added in v2 (optional).",
      "type": ["null", "int"],
      "default": null
    },
    {
      "name": "eventTimestamp",
      "doc": "When this event was produced. Added in v2 (optional).",
      "type": ["null", { "type": "long", "logicalType": "timestamp-millis" }],
      "default": null
    }
  ]
}